# ============================================================
# STARK Telecommunication — environment template
#
# Copy to .env and fill in values. NEVER commit a real .env.
# docker-compose reads .env from this directory (stark-api/).
# ============================================================

# ---- runtime ----
STARK_ENV=development            # development | staging | production
STARK_PORT=8080

# ---- data plane ----
STARK_DB_URL=postgres://stark:CHANGE_ME@localhost:5432/stark?sslmode=disable
STARK_REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=CHANGE_ME      # used by docker-compose postgres service

# ---- auth secrets (required) ----
STARK_JWT_ACCESS_SECRET=CHANGE_ME
STARK_JWT_REFRESH_SECRET=CHANGE_ME

# ---- payments: the SECRET key lives HERE ONLY — never in Flutter ----
# sk_test_… in staging, sk_live_… in production. Never commit real values.
PAYSTACK_SECRET_KEY=
# Public key (pk_test_… / pk_live_…) — safe for clients; Stark's hosted
# flow initializes server-side so this is optional.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Public HTTPS origin of this API, e.g. https://api.stark.ng
# Used for Paystack return URLs. NEVER localhost/private IPs in prod.
STARK_API_BASE_URL=

# ---- VTU provider credentials: server-side only (§16) ----
VTU_PROVIDER_A_URL=
VTU_PROVIDER_A_KEY=
VTU_PROVIDER_B_URL=
VTU_PROVIDER_B_KEY=

# ---- api / storage ----
STARK_CORS_ORIGINS=*
STARK_STORAGE_DIR=./storage      # dev object storage (R2/S3 adapter in prod)
